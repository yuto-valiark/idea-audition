# apps/server
HIP_PORT=8787
# fixture | gemini  （gemini は Day 2 で実装予定）
AI_GATEWAY=fixture
# 固定データの疑似待ち時間（ミリ秒）
FIXTURE_LATENCY_MS=900
# 下段の自動入れ替え間隔（ミリ秒、0で無効）
LOWER_ROTATION_MS=30000
# GEMINI_API_KEY=  ← 実際の値は .env か Secret Manager に置き、コミットしない

# apps/web（本番ビルド時のみ。開発時は Vite のプロキシを使う）
# VITE_HIP_URL=wss://<cloud-run-host>/hip
